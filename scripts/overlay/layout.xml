<!-- Reference only (1 Oct 2026): the overlay the user made before with gopro-dashboard-overlay, at 1920x1080. A guide to what strata360's overlay should show (docs/implementation-plan.md A2), not a file the pipeline must use as is. -->
<layout>
    <composite x="200" y="24" name="date_and_time">
        <component type="datetime" x="0" y="0" format="%Y/%m/%d" size="32" align="right"/>
        <component type="datetime" x="0" y="40" format="%H:%M:%S" size="40" align="right"/>
    </composite>

    <composite x="150" y="100" name="big_distance">
        <component type="text" x="0" y="50" size="16" align="right">km</component>
        <component type="metric" x="0" y="0" metric="odo" units="km" dp="1" align="right" size="48" />
    </composite>

    <composite x="150" y="875" name="big_pace">
        <component type="text" x="0" y="50" size="16" align="right">min/km</component>
        <component type="metric" x="0" y="0" metric="speed" units="pace_km" format="pace" align="right" size="48" />
    </composite>

    <composite x="220" y="980" name="gradient">
        <component type="text" x="70" y="0" size="16">SLOPE(%)</component>
        <component type="icon" x="0" y="0" file="slope-triangle.png" size="64"/>
        <component type="metric" x="70" y="18" metric="gradient" dp="0" size="32" />
    </composite>

    <composite x="16" y="980" name="altitude">
        <component type="metric_unit" x="70" y="0" metric="alt" units="alt" size="16">ALT({:~C})</component>
        <component type="icon" x="0" y="0" file="mountain.png" size="64"/>
        <component type="metric" x="70" y="18" metric="alt" units="alt" dp="0" size="32" />
    </composite>

    <composite x="1900" y="980" name="heartbeat">
        <component type="text" x="-70" y="0" size="16" align="right">BPM</component>
        <component type="icon" x="-64" y="0" file="heartbeat.png" size="64"/>
        <component type="metric" x="-70" y="18" metric="hr" dp="0" size="32" align="right"/>
    </composite>

    <component type="journey_map" name="journey_map" x="1644" y="24" size="256" corner_radius="35" opacity="0.6"/>
	
	<translate x="1644" y="304">
		<frame width="256" height="256" outline="255,0,0" cr="35" opacity="0.6">
		    <component type="moving_journey_map" name="moving_journey_map" size="256" zoom="14" />
		</frame>
	</translate>	
</layout>